FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

// R5 VAWT with pole: U 5 m/s along +x, tip-speed ratio 2 -> omega 19.23 rad/s. pole_rot rotates with the rotor (movingWallVelocity).
// Few fixed time steps; one step = 1 degree of rotation (dt = (pi/180)/omega).
// Base: tutorials/incompressible/pimpleFoam/RAS/propeller/system/controlDict; AMIWeights from tutorials/incompressible/pimpleFoam/RAS/propeller/system/AMIWeights.
application     pimpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.00907571211;
deltaT          0.000907571211;
writeControl    timeStep;
writeInterval   10;
purgeWrite      0;
writeFormat     binary;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable false;
adjustTimeStep  no;
functions
{
    AMIWeights1
    {
        type            AMIWeights;
        libs            (fieldFunctionObjects);
        writeFields     false;
        writeToFile     true;
        log             true;
        executeControl  timeStep;
        executeInterval 1;
    }
}
