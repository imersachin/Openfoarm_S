# Line endings.
#
# Text is stored with LF (as it already is). Files that bash or OpenFOAM read
# inside WSL/Linux must also be LF in the working tree, whatever a Windows
# checkout's core.autocrlf is: with CRLF, bash fails ($'\r') and the OpenFOAM
# dictionaries and captured logs no longer match what the tools wrote.
* text=auto

*.sh text eol=lf

# VAWT V0 evidence: OpenFOAM dictionaries (no file extension), captured logs and
# reproduction scripts.
openforam_preprocessor/tests/fixtures/vawt/v0/** text eol=lf

# Rotating-machinery G0 evidence: same reasons.
openforam_preprocessor/tests/fixtures/machines/g0/** text eol=lf

# .msh import (M1-MSH) E0 evidence: same reasons. The heads of binary .msh
# files are bytes, never converted.
openforam_preprocessor/tests/fixtures/msh/e0/** text eol=lf
openforam_preprocessor/tests/fixtures/msh/e0/E1_gmsh/logs/heads/*_bin.head binary

# Windows batch files run by cmd.exe.
*.cmd text eol=crlf
